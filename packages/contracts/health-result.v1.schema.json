{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:control-plane:health-result:v1",
  "title": "System Health Result",
  "type": "object",
  "additionalProperties": false,
  "x-provenance": "reconstructed-from-thread",
  "required": ["ok", "checkedAt", "workspacePaused"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspacePaused": {
      "type": "boolean"
    }
  }
}
