{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:control-plane:error:v1",
  "title": "Control Plane Error",
  "type": "object",
  "additionalProperties": false,
  "x-provenance": "reconstructed-from-thread",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
