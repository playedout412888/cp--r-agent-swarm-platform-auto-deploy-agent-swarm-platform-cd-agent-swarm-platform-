{
  "name": "@21amg/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gate A local control plane: Fastify API + worker for system.health and project.dailyBrief.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "migrate": "tsx database/migrate.ts up",
    "seed": "tsx database/migrate.ts seed",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
