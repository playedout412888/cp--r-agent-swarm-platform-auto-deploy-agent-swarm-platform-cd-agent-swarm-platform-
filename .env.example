# Local Gate A only. Not a production configuration.
CONTROL_PLANE_ENV=development
DATABASE_URL=postgres://control:control@127.0.0.1:5432/control_plane
CONTROL_PLANE_TOKEN=local-dev-controller-token
CONTROL_PLANE_BIND=127.0.0.1
CONTROL_PLANE_PORT=3000

# Leave empty. The AI adapter fails closed without a key and does not call providers in Gate A.
AI_PROVIDER_API_KEY=
